# Pinned k3s release. The binary is downloaded from the k3s GitHub release
# and must match K3S_SHA256 (from that release's sha256sum-amd64.txt) before
# anything is installed.
K3S_VERSION=v1.36.5+k3s1
K3S_SHA256=d73847bcd3c5fccef0115b372e2f9a91f3032dc84bbf71518a4617565294d313

# The user tenkai-server runs as, and where it reads the kubeconfig of its
# cluster identity: <KUBECONFIG_DIR>/<environment>.kubeconfig. Set the same
# path with `tenkaictl env cluster-config set` when creating the environment.
TENKAI_USER=tenkai
KUBECONFIG_DIR=/var/lib/tenkai/cluster
