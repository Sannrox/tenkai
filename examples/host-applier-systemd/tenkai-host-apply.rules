// Lets the unprivileged `tenkai` user start and stop instances of
// tenkai-host-apply@.service, and refuses it every other systemd action:
// no other unit, no other verb (ADR 0041 §2). Install as
// /etc/polkit-1/rules.d/50-tenkai-host-apply.rules.
polkit.addRule(function (action, subject) {
    if (subject.user !== "tenkai" ||
        action.id.indexOf("org.freedesktop.systemd1.") !== 0) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (/^tenkai-host-apply@[0-9a-f]{64}\.service$/.test(unit) &&
            (verb === "start" || verb === "stop")) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NO;
});
